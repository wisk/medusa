{
  "name": "medusa",
  "version": "0.5.4",
  "description": "A modular and interactive binary disassembler",
  "homepage": "https://github.com/wisk/medusa",
  "dependencies": [
    "boost-graph",
    "boost-multiprecision",
    "boost-signals2",
    "boost-uuid",
    "cli11",
    "pegtl",
    "catch2",
    "nanobind",
    "sqlite3",
    "sqlite-orm"
  ],
  "features": {
    "gui": {
      "description": "Qt5-based GUI frontend (qMedusa)",
      "dependencies": [
        "qt5-base",
        "qt5-widgets"
      ]
    },
    "ogdf": {
      "description": "OGDF graph layout support",
      "dependencies": [
        "ogdf"
      ]
    },
    "llvm": {
      "description": "LLVM-based compiler and emulator modules",
      "dependencies": [
        "llvm"
      ]
    }
  }
}
